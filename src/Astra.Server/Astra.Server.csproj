<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>astra-server</AssemblyName>
    <RootNamespace>Astra.Server</RootNamespace>
    <SelfContained>true</SelfContained>
    <UserSecretsId>astra-server</UserSecretsId>
    <!-- AOT analyzer gate (IL2026/IL3050 are errors); does not flow through ProjectReference, so set per project. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The lambda Map* endpoints in Api/ are covered by the Request Delegate
         Generator, which the SDK auto-enables for AOT publishes. Turn it on
         for plain builds too so the analyzer gate sees the same call sites. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <ItemGroup>
    <!-- DTOs moved to Astra.Api.Contracts keep working in Server code without a using per file. -->
    <Using Include="Astra.Api.Contracts" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.11.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Astra.Core\Astra.Core.csproj" />
    <ProjectReference Include="..\Astra.Api.Contracts\Astra.Api.Contracts.csproj" />
    <ProjectReference Include="..\Astra.Data\Astra.Data.csproj" />
    <ProjectReference Include="..\Astra.Providers\Astra.Providers.csproj" />
    <ProjectReference Include="..\Astra.Gateway\Astra.Gateway.csproj" />
    <ProjectReference Include="..\Astra.Clients\Astra.Clients.csproj" />
    <ProjectReference Include="..\Astra.Plugins\Astra.Plugins.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Astra.Server.IntegrationTests" />
  </ItemGroup>
  <Import Project="..\MacOsFloor\MacOsFloor.targets" />
</Project>
